/* Synthetic Liberty fixture for checking the OpenSTA command flow only. */
library (smoke_lib) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1.0;
  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.1");
    index_2 ("0.1");
  }
  cell (AND2_X1) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.01; }
    pin (B) { direction : input; capacitance : 0.01; }
    pin (Y) {
      direction : output;
      function : "A & B";
      max_capacitance : 10;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_template) { values ("0.1"); }
        cell_fall (delay_template) { values ("0.1"); }
        rise_transition (delay_template) { values ("0.05"); }
        fall_transition (delay_template) { values ("0.05"); }
      }
      timing () {
        related_pin : "B";
        timing_sense : positive_unate;
        cell_rise (delay_template) { values ("0.1"); }
        cell_fall (delay_template) { values ("0.1"); }
        rise_transition (delay_template) { values ("0.05"); }
        fall_transition (delay_template) { values ("0.05"); }
      }
    }
  }
}
